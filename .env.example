# Mandi Minutes Production Environment Variables Template
# Copy this file to .env.local and populate with your production credentials.
# NEVER commit .env or .env.local to version control.

# Firebase Web App Configuration (Client-side)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=mandi-minutes-virar.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mandi-minutes-virar
VITE_FIREBASE_STORAGE_BUCKET=mandi-minutes-virar.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_VAPID_KEY=BNx...

# Razorpay Gateway Configuration (Client-side Public Key)
VITE_RAZORPAY_KEY_ID=rzp_live_...

# Backend Secret Configuration (For Firebase Cloud Functions / Server only)
# Set via: firebase functions:config:set razorpay.key_secret="..." razorpay.webhook_secret="..."
# RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
# RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_signing_secret

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    // Secure token-based admin email verification
    function isAdminEmail() {
      return request.auth.token.email != null && (
        request.auth.token.email == 'admin@mandiminutes.com' ||
        request.auth.token.email == 'admin@mandi.in'
      );
    }
    function admin() { return signedIn() && (userDoc().role == 'admin' || isAdminEmail()); }
    function vendorFor(storeId) { return signedIn() && userDoc().role == 'vendor' && userDoc().storeId == storeId; }
    function riderFor(order) { return signedIn() && userDoc().role == 'rider' && order.riderId == request.auth.uid; }

    match /users/{uid} {
      allow read: if own(uid) || admin();
      // Allow user creation without self-escalation unless verified admin email
      allow create: if own(uid) && request.resource.data.uid == uid && (request.resource.data.role == 'customer' || (isAdminEmail() && request.resource.data.role == 'admin'));
      allow update: if admin() || (own(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.storeId == resource.data.storeId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'phone', 'addresses', 'wishlist', 'avatar', 'fcmTokens', 'updatedAt']));
      allow delete: if admin();
    }

    match /stores/{storeId} {
      allow read: if resource.data.status == 'approved' || admin() || vendorFor(storeId);
      allow create, delete: if admin();
      allow update: if admin() || (vendorFor(storeId)
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'address', 'city', 'pincodes', 'deliveryTime', 'minOrder', 'deliveryCharge', 'image', 'description', 'upiId', 'updatedAt']));
      match /reviews/{reviewId} { allow read: if true; allow write: if false; }
    }

    match /vendorApplications/{applicationId} {
      allow read: if own(resource.data.applicantId) || admin();
      allow write: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if admin() || vendorFor(request.resource.data.storeId);
      allow update: if admin() || (vendorFor(resource.data.storeId) && request.resource.data.storeId == resource.data.storeId);
      allow delete: if admin() || vendorFor(resource.data.storeId);
    }

    match /orders/{orderId} {
      // Admin reads all; customers read own; vendors and riders read assigned
      allow read: if signedIn() && (admin() || own(resource.data.customerId) || vendorFor(resource.data.storeId) || riderFor(resource.data));
      // Authenticated customer creates their order document
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      // Admin, assigned vendor, or assigned rider can transition order status
      allow update: if signedIn() && (own(resource.data.customerId) || admin() || vendorFor(resource.data.storeId) || riderFor(resource.data));
      allow delete: if admin();
    }

    match /tickets/{ticketId} {
      allow read: if own(resource.data.customerId) || admin();
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid && request.resource.data.status == 'open';
      allow update: if admin() || (own(resource.data.customerId)
        && request.resource.data.status == resource.data.status
        && request.resource.data.reply == resource.data.reply
        && request.resource.data.customerId == resource.data.customerId);
      allow delete: if admin();
    }

    match /banners/{id} { allow read: if true; allow write: if admin(); }
    match /categories/{id} { allow read: if true; allow write: if admin(); }
    match /paymentEvents/{id} { allow read, write: if false; }
  }
}
